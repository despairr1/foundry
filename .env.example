# ====================================================================
# Foundry — settings (copy to .env; Settings in the app edits .env too)
# Every value here has a sensible default; only the keys are required.
# ====================================================================

# --- AI models and keys ---
# The three roles: Claude designs (architect), Gemini checks (auditor), the code writer implements.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-fable-5-1
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_MAX_TOKENS=65536
ANTHROPIC_REFUSAL_FALLBACKS=true

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Empty: the model's full output window (65,536 on thinking models)
GEMINI_MAX_OUTPUT_TOKENS=

# The code writer: OpenAI, or any OpenAI-compatible provider through ASTRA_* (Settings › API keys & providers sets these).
# Without any OpenAI/ASTRA key, Claude writes the code too.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
ASTRA_API_KEY=
ASTRA_MODEL=
ASTRA_BASE_URL=https://api.openai.com/v1/chat/completions
ASTRA_MAX_TOKENS=
# Per-million-token prices for a custom code writer (used by the spending limit)
ASTRA_INPUT_PRICE_PER_M=
ASTRA_OUTPUT_PRICE_PER_M=
FOUNDRY_SYNTHESIZER=openai

# How hard the models think: low, medium, high, xhigh, max
FOUNDRY_THINKING=high
REQUEST_TIMEOUT_MS=600000
REQUEST_MAX_RETRIES=3

# --- Spending limits (USD) ---
MAX_BUDGET_USD=5.00
MAX_MODULE_BUDGET_USD=
UI_SELF_IMPROVE_LIMIT=5.00
FOUNDRY_CHAT_BUDGET_USD=1.00

# --- Builds ---
MAX_CONVERGENCE_ITERATIONS=8
MIN_MUTATION_KILL_RATIO=0.85
# Methods from the papers (Help > Methods): a hidden acceptance suite per part (GEF), the attempts in a row with the
# same result that end a branch (TCA; 0 = never), and caching the fixed part of prompts (TCA)
FOUNDRY_HOLDOUT_TESTS=true
FOUNDRY_THRASH_LIMIT=3
FOUNDRY_PROMPT_CACHING=true
AUTO_GIT_COMMIT=true
# true: tests always run on this machine; false: the Docker sandbox when Docker is running
FOUNDRY_FORCE_LOCAL_SANDBOX=false
FOUNDRY_SANDBOX_IMAGE=foundry-sandbox:latest
FOUNDRY_SANDBOX_TIMEOUT_MS=120000
FOUNDRY_LSP_TIMEOUT_MS=1500
DOCKER_MEMORY_MB=1024
DOCKER_CPUS=2.0
# true: deterministic stand-ins instead of the models (a demo, nothing real is built)
FOUNDRY_OFFLINE_MODE=false
FOUNDRY_SQLITE_PATH=.foundry-memory.sqlite
FOUNDRY_FREEZE_PATH=.foundry-freeze.json
NODE_BINARY_PATH=node

# --- Improve (Foundry improving its own engine) and Ouroboros ---
UI_SELF_IMPROVE_ROUNDS=1
OUROBOROS_AUTO_HEAL=true
OUROBOROS_MAX_LAG_MS=180
OUROBOROS_MAX_AST_MS=350
OUROBOROS_MAX_HEAP_MB=1024
OUROBOROS_AUTO_RESTART=false

# --- The window ---
UI_THEME_MODE=Dark
UI_START_PAGE=improve
UI_CONFIRM_STOP=true
UI_OPEN_OVERVIEW=true
SOUND_NOTIFICATIONS=true
TERMINAL_SHELL=auto
TERMINAL_FONT_FAMILY=
TERMINAL_FONT_SIZE=12
TERMINAL_SCROLLBACK=5000
